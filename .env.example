# Path to the SQLite database (relative or absolute).
# Defaults to ./data/premodern.db when unset.
PREMODERN_DB_PATH=./data/premodern.db

# Public site URL (used for canonical links, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible analytics domain (optional, enables the analytics tag when set).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=premodernmentat.com

# Admin panel — set to enable /admin/* (curated video playlists, etc.).
# Leave unset to disable the admin login route entirely.
# ADMIN_PASSWORD=change-me

# Optional override for the admin session HMAC seed.
# Defaults to a value derived from ADMIN_PASSWORD; rotate this to force re-login.
# ADMIN_SESSION_SECRET=

# Cron secret for the future /api/cron/prices endpoint (Scryfall daily ingest).
# CRON_SECRET=
