# Path to the SQLite database (relative or absolute).
# Defaults to ./data/premodern.db when unset.
PREMODERN_DB_PATH=./data/premodern.db

# Public site URL (used for canonical links, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible analytics domain (optional, enables the analytics tag when set).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=premodernmentat.com
